{
  "name": "speshway-all-in-one-erp",
  "version": "1.0.0",
  "description": "Speshway All-In-One ERP System built with MERN stack",
  "scripts": {
    "start": "node server/src/server.js",
    "build": "npm --prefix client run build",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "server:start": "npm --prefix server start",
    "client:build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "keywords": [
    "mern",
    "erp",
    "mongodb",
    "express",
    "react",
    "nodejs"
  ],
  "author": "",
  "license": "ISC"
}
